# Example environment variables for JoyousChat
# Replace placeholder values before deploying.

# Postgres connection (Supabase). Example format:
# postgres://username:password@host:5432/database
DATABASE_URL=postgres://user:password@db-host:5432/dbname
# Local runtime URL (used as a helpful default in some configs)
V0_RUNTIME_URL=http://localhost:3000

# NOTE: Do NOT commit real secrets to the repo. Add any provider keys
# (AI provider keys, Better Auth secrets, etc.) in your Vercel/Supabase
# environment settings when you deploy.
