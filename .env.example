# Example environment variables for JoyousChat
# Replace placeholder values before deploying.

# Postgres connection (Supabase). Example format:
# postgres://username:password@host:5432/database
DATABASE_URL=postgres://user:password@db-host:5432/dbname

# Optional: AI model identifier used by the `ai` SDK.
AI_MODEL=anthropic/claude-3.5

# API keys for AI providers (set only the one you use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Better Auth / trusted origins (if using Better Auth)
BETTER_AUTH_URL=https://your-better-auth.example.com
V0_RUNTIME_URL=http://localhost:3000
# Vercel runtime/prod URLs (set in Vercel dashboard, usually not needed locally)
VERCEL_URL=your-vercel-preview-url.vercel.app
VERCEL_PROJECT_PRODUCTION_URL=your-vercel-production-url.vercel.app

# Other optional secrets
#EMAIL_PROVIDER_API_KEY=...
